FROM golang:1.26

RUN git config --global --add safe.directory /src

# QA tools
RUN go install mvdan.cc/gofumpt@latest \
 && go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest

# golang-migrate for migration idempotency check
RUN curl -sSfL https://github.com/golang-migrate/migrate/releases/download/v4.18.1/migrate.linux-amd64.tar.gz \
      | tar -xz -C /usr/local/bin migrate

WORKDIR /src
